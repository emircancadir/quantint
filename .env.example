# ── Local development ───────────────────────────────────────────────────────
# Copy to .env and adjust. `docker compose up -d db` starts Postgres on 5433.
DATABASE_URL="postgresql://quantint:quantint@localhost:5433/quantint"

# Seeded admin account: prisma/seed.ts creates (or promotes) this user as ADMIN.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Auth.js session secret. Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Public site origin (canonical URLs, sitemap, OG images).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Live market data (optional; keyless Frankfurter+CoinGecko always run).
# Set MARKET_PROVIDER=twelvedata with a free-tier key to add XAU/indices.
MARKET_PROVIDER=""
MARKET_API_KEY=""
TICKER_POLL_MINUTES="5"

# ── Production (docker-compose.prod.yml reads these) ────────────────────────
# DB_PASSWORD="strong-password-for-postgres"
# SITE_DOMAIN="quantint.com.tr"
